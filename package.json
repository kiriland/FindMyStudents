{
  "name": "FindMyStudents",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "prep:standalone": "next build && cp -r public .next/standalone/public && cp -r .next/static .next/standalone/.next/static && cp bootstrap.js .next/standalone/index.js && sh scripts/dereference-standalone.sh",
    "lint": "oxlint --deny-warnings .",
    "format": "oxfmt --write",
    "format:check": "oxfmt --check",
    "lint:fix": "oxlint --fix ."
  },
  "dependencies": {
    "@aws-amplify/adapter-nextjs": "^1.8.1",
    "@aws-sdk/client-dynamodb": "^3.1157.0",
    "@aws-sdk/client-rekognition": "^3.1170.0",
    "@aws-sdk/client-s3": "^3.1170.0",
    "@aws-sdk/lib-dynamodb": "^3.1157.0",
    "@aws-sdk/s3-presigned-post": "^3.1170.0",
    "@aws-sdk/s3-request-presigner": "^3.1170.0",
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@marsidev/react-turnstile": "1.6.3",
    "aws-amplify": "^6.22.2",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
